APP_NAME=ArtistApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:4200

# Opcional: crea un administrador al ejecutar php artisan db:seed.
# Usa una contraseña propia y no compartas el archivo .env.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vrb_artistapp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@artistapp.local"
MAIL_FROM_NAME="ArtistApp"

# Opcional: integración Discord. Mantén el token solo en backend/.env.
